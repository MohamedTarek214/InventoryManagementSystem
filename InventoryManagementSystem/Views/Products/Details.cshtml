@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Product Details</h2>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </div>

    <hr />

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">@Model.Name</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Product ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "-"
                                        : Model.Description)
                </dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">@Model.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Quantity In Stock</dt>
                <dd class="col-sm-9">@Model.QuantityInStock</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">
                    @(Model.Category?.Name ?? "-")
                </dd>

                <dt class="col-sm-3">Supplier</dt>
                <dd class="col-sm-9">@Model.Supplier</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9">
                    @(Model.UpdatedAt.HasValue
                                        ? Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")
                                        : "-")
                </dd>
            </dl>
        </div>

        <div class="card-footer">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit Product
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                Delete Product
            </a>
        </div>
    </div>
</div>
